37868>>>                // If from main, this is a propbably a main file Select to Zoom.
37868>>>                Case Break
37869>>>
37869>>>            Case (NavigateData.eNavigateType = nfFromParent)
37872>>>                // If from parent, this is a constrained drill down.
37872>>>                Case Break
37873>>>
37873>>>            Case (NavigateData.eNavigateType = nfFromChild)
37876>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37876>>>                Case Break
37877>>>
37877>>>            Case Else // must be nfUndefined
37877>>>
37877>>>        Case End
37877>>>
37877>>>        Send SetActionButtons
37878>>>
37878>>>    End_Procedure
